diff --git a/kernel-6.6/include/linux/cred.h b/kernel-6.6/include/linux/cred.h
index bb55703e1..bde5cfc7b 100644
--- a/kernel-6.6/include/linux/cred.h
+++ b/kernel-6.6/include/linux/cred.h
@@ -145,6 +145,23 @@ struct cred {
 	};
 } __randomize_layout;
 
+/*
+ * Samsung KDP (Knox Kernel Data Protection) compatibility shims - see the
+ * implementation at the bottom of kernel/cred.c. Stock Samsung modules are
+ * built with CONFIG_KDP_CRED=y and reference these helpers instead of
+ * touching cred->usage / cred->non_rcu directly.
+ */
+#ifndef CONFIG_KDP_CRED
+extern bool kdp_enable;
+extern void kdp_usecount_inc(struct cred *cred);
+extern unsigned int kdp_usecount_inc_not_zero(struct cred *cred);
+extern unsigned int kdp_usecount_dec_and_test(struct cred *cred);
+extern unsigned int kdp_get_usecount(struct cred *cred);
+extern void kdp_set_cred_non_rcu(struct cred *cred, int val);
+extern int is_kdp_protect_addr(unsigned long addr);
+extern int security_integrity_current(void);
+#endif /* !CONFIG_KDP_CRED */
+
 extern void __put_cred(struct cred *);
 extern void exit_creds(struct task_struct *);
 extern int copy_creds(struct task_struct *, unsigned long);
diff --git a/kernel-6.6/kernel/cred.c b/kernel-6.6/kernel/cred.c
index 559c85b9c..1b97e8955 100644
--- a/kernel-6.6/kernel/cred.c
+++ b/kernel-6.6/kernel/cred.c
@@ -735,3 +735,80 @@ int set_create_files_as(struct cred *new, struct inode *inode)
 	return security_kernel_create_files_as(new, inode);
 }
 EXPORT_SYMBOL(set_create_files_as);
+
+/*
+ * ---------------------------------------------------------------------------
+ * Samsung KDP (Knox Kernel Data Protection) compatibility shims
+ * ---------------------------------------------------------------------------
+ * Samsung ships its stock kernel with CONFIG_KDP_CRED=y. With that option the
+ * inline helpers in <linux/cred.h> (get_cred(), get_cred_rcu(), put_cred(),
+ * get_new_cred()) do NOT touch cred->usage directly, they call out to the KDP
+ * helpers instead:
+ *
+ *	kdp_usecount_inc()		instead of atomic_long_inc(&cred->usage)
+ *	kdp_usecount_inc_not_zero()	instead of atomic_long_inc_not_zero()
+ *	kdp_usecount_dec_and_test()	instead of atomic_long_dec_and_test()
+ *	kdp_set_cred_non_rcu()		instead of cred->non_rcu = val
+ *
+ * Every stock Samsung .ko that takes a reference on credentials (bluetooth.ko
+ * from system_dlkm, a bunch of vendor modules, ...) therefore has undefined
+ * references to those symbols. On a plain AOSP/GKI kernel they do not exist,
+ * so loading such a module fails with:
+ *
+ *	bluetooth: Unknown symbol kdp_set_cred_non_rcu (err -2)
+ *	bluetooth: Unknown symbol kdp_usecount_inc (err -2)
+ *	bluetooth: Unknown symbol kdp_usecount_dec_and_test (err -2)
+ *
+ * ...which on an A34 (a34x/mt6877) running the stock ROM kills Bluetooth
+ * completely (bt_drv_6877 then cannot resolve hci_* either).
+ *
+ * We do not implement KDP itself (creds are ordinary, unprotected kernel
+ * objects here), we only provide the vanilla behaviour behind those names so
+ * that stock Samsung modules keep working on this kernel.
+ */
+#ifndef CONFIG_KDP_CRED
+void kdp_usecount_inc(struct cred *cred)
+{
+	atomic_long_inc(&cred->usage);
+}
+EXPORT_SYMBOL(kdp_usecount_inc);
+
+unsigned int kdp_usecount_inc_not_zero(struct cred *cred)
+{
+	return atomic_long_inc_not_zero(&cred->usage) ? 1 : 0;
+}
+EXPORT_SYMBOL(kdp_usecount_inc_not_zero);
+
+unsigned int kdp_usecount_dec_and_test(struct cred *cred)
+{
+	return atomic_long_dec_and_test(&cred->usage) ? 1 : 0;
+}
+EXPORT_SYMBOL(kdp_usecount_dec_and_test);
+
+unsigned int kdp_get_usecount(struct cred *cred)
+{
+	return (unsigned int)atomic_long_read(&cred->usage);
+}
+EXPORT_SYMBOL(kdp_get_usecount);
+
+void kdp_set_cred_non_rcu(struct cred *cred, int val)
+{
+	cred->non_rcu = val;
+}
+EXPORT_SYMBOL(kdp_set_cred_non_rcu);
+
+int is_kdp_protect_addr(unsigned long addr)
+{
+	return 0;
+}
+EXPORT_SYMBOL(is_kdp_protect_addr);
+
+int security_integrity_current(void)
+{
+	return 0;
+}
+EXPORT_SYMBOL(security_integrity_current);
+
+bool kdp_enable;
+EXPORT_SYMBOL(kdp_enable);
+#endif /* !CONFIG_KDP_CRED */
