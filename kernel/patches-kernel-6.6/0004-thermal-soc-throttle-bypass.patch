+/*
+ * SoC thermal throttle bypass
+ * ---------------------------
+ * When soc_nothrottle is set, the governor is not invoked for the
+ * non-critical (ACTIVE/PASSIVE) trips of SoC thermal zones, which removes
+ * kernel-side thermal throttling of the CPU/GPU/skin cooling loops.
+ *
+ * Hard limits, deliberately not configurable:
+ *
+ *  - THERMAL_TRIP_HOT and THERMAL_TRIP_CRITICAL are never bypassed, so
+ *    handle_critical_trips() -> tz->ops->critical() ->
+ *    thermal_zone_device_critical() -> hw_protection_shutdown() still runs
+ *    and a genuine overheat still powers the device off.
+ *  - Battery, charger, USB-connector and PMIC zones are never bypassed
+ *    whatever they are called, so charge termination and connector
+ *    overheat protection keep working.
+ *  - No temperature is faked. tz->temperature, the sysfs 'temp' attribute
+ *    and thermal_genl_sampling_temp() all keep reporting the real reading,
+ *    so nothing downstream is lied to and the critical path above still
+ *    sees the true value.
+ *
+ * Scope: this stops *kernel* governors only. An Android thermal HAL that
+ * drives cooling devices from userspace is outside this file.
+ */
+static bool soc_nothrottle;
+module_param(soc_nothrottle, bool, 0444);
+MODULE_PARM_DESC(soc_nothrottle,
+	"Skip governor throttling for SoC (CPU/GPU/skin) thermal zones");
+
+/*
+ * Zones that always keep their mitigation. Matched as substrings of
+ * tz->type and checked before the bypass list, so this one wins.
+ */
+static const char * const throttle_protected_zones[] = {
+	"batt", "bat_", "vbat", "charger", "chg", "usb", "pmic", "fuel",
+};
+
+/* SoC zones whose governor throttling may be bypassed. */
+static const char * const throttle_bypass_zones[] = {
+	"cpu", "gpu", "soc", "npu", "apu", "little", "big",
+	"tzts", "tsens", "ts", "skin", "ap",
+};
+
+static bool thermal_zone_name_has(const char * const *table, size_t n,
+				  const char *name)
+{
+	size_t i;
+
+	for (i = 0; i < n; i++)
+		if (strstr(name, table[i]))
+			return true;
+
+	return false;
+}
+
+static bool thermal_zone_throttle_bypassed(struct thermal_zone_device *tz)
+{
+	if (!soc_nothrottle)
+		return false;
+
+	/* Battery / charger / connector / PMIC keep their mitigation. */
+	if (thermal_zone_name_has(throttle_protected_zones,
+				  ARRAY_SIZE(throttle_protected_zones),
+				  tz->type))
+		return false;
+
+	return thermal_zone_name_has(throttle_bypass_zones,
+				     ARRAY_SIZE(throttle_bypass_zones),
+				     tz->type);
+}
+
 static void handle_non_critical_trips(struct thermal_zone_device *tz, int trip)
 {
 	tz->governor ? tz->governor->throttle(tz, trip) :
@@ -369,7 +442,7 @@ static void handle_thermal_trip(struct thermal_zone_device *tz, int trip_id)
 
 	if (trip.type == THERMAL_TRIP_CRITICAL || trip.type == THERMAL_TRIP_HOT)
 		handle_critical_trips(tz, trip_id, trip.temperature, trip.type);
-	else
+	else if (!thermal_zone_throttle_bypassed(tz))
 		handle_non_critical_trips(tz, trip_id);
 }
 
