index d553a234b..68bd5f990 100644
--- a/drivers/cpufreq/cpufreq.c
+++ b/drivers/cpufreq/cpufreq.c
@@ -28,6 +28,7 @@
 #include <linux/slab.h>
 #include <linux/suspend.h>
 #include <linux/syscore_ops.h>
+#include <linux/thermal.h>
 #include <linux/tick.h>
 #include <linux/units.h>
 #include <trace/events/power.h>
@@ -2413,6 +2414,35 @@ __weak struct cpufreq_governor *cpufreq_fallback_governor(void)
 	return NULL;
 }
 
+/*
+ * Report to the thermal performance gate whether any policy currently runs the
+ * "performance" governor.
+ *
+ * The whole set of online CPUs is rescanned on every transition and the
+ * *result* is reported, not a per-policy delta. That makes the report
+ * idempotent: a repeated call, or a governor->init() that fails after
+ * governor->exit() already ran, cannot leave the gate latched in the wrong
+ * state. cpufreq_cpu_get_raw() is a lockless per-CPU lookup, so this is safe
+ * to call from the governor switch path.
+ */
+static void cpufreq_perf_gate_sync(void)
+{
+	struct cpufreq_policy *policy;
+	bool any_perf = false;
+	int cpu;
+
+	for_each_online_cpu(cpu) {
+		policy = cpufreq_cpu_get_raw(cpu);
+		if (policy && policy->governor &&
+		    !strcmp(policy->governor->name, "performance")) {
+			any_perf = true;
+			break;
+		}
+	}
+
+	thermal_perf_gate_set_auto_perf(any_perf);
+}
+
 static int cpufreq_init_governor(struct cpufreq_policy *policy)
 {
 	int ret;
@@ -2456,6 +2486,9 @@ static int cpufreq_init_governor(struct cpufreq_policy *policy)
 
 	policy->strict_target = !!(policy->governor->flags & CPUFREQ_GOV_STRICT_TARGET);
 
+	/* Performance governor engaged on this policy - re-evaluate the gate. */
+	cpufreq_perf_gate_sync();
+
 	return 0;
 }
 
@@ -2470,6 +2503,12 @@ static void cpufreq_exit_governor(struct cpufreq_policy *policy)
 		policy->governor->exit(policy);
 
 	module_put(policy->governor->owner);
+
+	/*
+	 * The performance governor has left this policy. Rescan so the gate
+	 * disengages the moment no policy is using it any more.
+	 */
+	cpufreq_perf_gate_sync();
 }
 
 int cpufreq_start_governor(struct cpufreq_policy *policy)
